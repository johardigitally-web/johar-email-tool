# Copy to .env and fill in. Nothing here is committed.

# --- the tool itself ---
MAILER_PASSWORD=kies-een-wachtwoord
MAILER_SECRET=plak-hier-iets-willekeurigs-en-langs

# --- the big switch. Leave it off until you have sent yourself a test. ---
SENDING_ENABLED=false

# --- where the mail goes out ---
# Your outgoing mail server. Whatever you use, the From address below has to be
# on a domain whose SPF, DKIM and DMARC are published and passing, or half of
# what you send will be junked. deploy/mailserver.sh will set up a mail server
# on your own machine if you would rather not pay a relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
FROM_EMAIL=Your Shop <noreply@example.com>
REPLY_TO=

# --- pacing. These bound a mistake more than they tune performance. ---
BATCH_SIZE=25
SEND_PAUSE=0.4
DAILY_CAP=300

# Legally required in the footer of every marketing email.
POSTAL_ADDRESS=

# Where the unsubscribe link and the open pixel point. MUST be an address a
# recipient's mail client can reach. While this is localhost the tool still
# composes, imports and test-sends, but it refuses to send a real campaign.
PUBLIC_URL=http://127.0.0.1:5000
FALLBACK_URL=

# --- importing subscribers from the webshop ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_SECRET=

# --- the shop this sends for --------------------------------------------------
# Everything below is what turns a generic tool into your shop. Leave any of
# them empty and the part of the email that needs it is simply left out, which
# is better than a broken image or a link to nobody.

# The name in the From line, the footer and the page header.
SHOP_NAME=Your Shop

# Your webshop. Product links are only accepted on this host, so it is a safety
# setting as well as a convenience one.
SHOP_URL=https://example.com

# A logo for the top of every email. Must be a public https address. Empty
# means no logo row at all.
LOGO_URL=

# International format, digits only, for example 31612345678. Empty means the
# WhatsApp button and the WhatsApp block are not drawn.
WHATSAPP_NUMBER=

# Required by law in most of Europe, and the tool refuses to send without it:
# every commercial email has to carry a real postal address.
POSTAL_ADDRESS=

# Chamber of commerce number, shown in the footer. Empty leaves the line out.
KVK=

# Linked in the footer next to the unsubscribe link.
PRIVACY_URL=

# Who may receive mail while you are testing. A comma separated list. LEAVE
# THIS SET to your own address until you are certain, because it is the last
# thing standing between a mistake and your whole customer list.
ALLOWED_RECIPIENTS=you@example.com
